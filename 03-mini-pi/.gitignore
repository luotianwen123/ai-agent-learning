# Python 产物
__pycache__/
*.pyc
*.pyo

# 虚拟环境（依赖看 requirements.txt，不提交环境本身）
.venv/
venv/

# 密钥：绝不进版本库
.env
.env.local

# 回归基线临时文件（每次重构对比用，不长期保留）
baseline.txt
after.txt

# 编辑器
.idea/
.vscode/

# 脱敏/改写前的备份：里面留着原始内容，可能含本机绝对路径，绝不进版本库
# 2026-11-09 教训：trace/ 是有意提交的，所以备份文件不能就地躺着，
# 否则 git add . 会把「脱敏前的原件」一起推上公开仓库
*.bak
*.bak_*
